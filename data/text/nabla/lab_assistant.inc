@ Texts of the lab assistant (data/scripts/nabla/lab_assistant.inc)

Nabla_Text_LabAssistantShowMe:
	.string "I study the items that go with very\n"
	.string "powerful POKéMON.\p"
	.string "Show me one of yours, and I'll give\n"
	.string "you what goes with it!$"

Nabla_Text_LabAssistantHereYouGo:
	.string "Oh! I have just what {STR_VAR_1}\n"
	.string "needs. Here you go!$"

Nabla_Text_LabAssistantReceivedItems:
	.string "{PLAYER} received {STR_VAR_2} items\n"
	.string "for {STR_VAR_1}!$"

Nabla_Text_LabAssistantPutAway:
	.string "{PLAYER} put them away in the BAG.$"

Nabla_Text_LabAssistantSecretMove:
	.string "{STR_VAR_1} has a secret move!\n"
	.string "Let me help it remember it.$"

Nabla_Text_LabAssistantNothing:
	.string "Hmm… I don't know of any item that\n"
	.string "goes with {STR_VAR_1}.$"

Nabla_Text_LabAssistantHasAll:
	.string "You already have everything that\n"
	.string "goes with {STR_VAR_1}!$"

Nabla_Text_LabAssistantComeBack:
	.string "If you lose them, or use them up,\n"
	.string "come back and see me!$"

Nabla_Text_LabAssistantBye:
	.string "Come back when you want to show me\n"
	.string "a POKéMON!$"
