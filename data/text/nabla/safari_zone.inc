Nabla_Text_SafariZoneWouldYouLikeToEnter:
	.string "Welcome to the SAFARI ZONE!\p"
	.string "Here, you can meet POKéMON from\n"
	.string "faraway regions.\p"
	.string "Would you like to go in?$"

Nabla_Text_SafariZoneInfo:
	.string "In the SAFARI ZONE, you battle and\n"
	.string "catch POKéMON with your own team.\p"
	.string "Each visit, you explore one region:\n"
	.string "only its POKéMON appear.\p"
	.string "The stronger you get, the stronger\n"
	.string "the POKéMON you'll meet!$"

Nabla_Text_SafariZoneEnjoy:
	.string "Today, the SAFARI ZONE is home to\n"
	.string "POKéMON from {STR_VAR_1}.\p"
	.string "Enjoy yourself! Talk to the attendant\n"
	.string "at the gate when you want to leave.$"

Nabla_Text_SafariZoneLeave:
	.string "Would you like to leave the\n"
	.string "SAFARI ZONE?$"

Nabla_Text_SafariZoneThanks:
	.string "Thank you for visiting.\n"
	.string "We hope to see you again!$"

Nabla_Text_SafariZoneRegionKanto:
	.string "KANTO$"
