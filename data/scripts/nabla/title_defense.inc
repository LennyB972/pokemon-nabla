	return

Nabla_ChampionsRoom_EventScript_WattsonGfx:
	setvar VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_WATTSON
	return

Nabla_ChampionsRoom_EventScript_FlanneryGfx:
